{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "1"
          ]
        },
        "engine_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "parameter_set_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "security_profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "FHE-Q1"
            ]
          },
          "minItems": 1,
          "maxItems": 1
        },
        "program_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "operators": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ADD",
              "MUL"
            ]
          },
          "minItems": 1,
          "maxItems": 2
        },
        "arithmetic": {
          "type": "string",
          "enum": [
            "EXACT_MODULAR"
          ]
        },
        "max_parallel_executions": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)(?![\\s\\S])"
        }
      },
      "required": [
        "schema_version",
        "engine_digest",
        "parameter_set_digest",
        "security_profiles",
        "program_digests",
        "operators",
        "arithmetic",
        "max_parallel_executions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "capabilities"
  ],
  "additionalProperties": false
}
