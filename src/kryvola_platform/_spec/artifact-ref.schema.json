{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "opaque_artifact_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "tenant_scope": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "immutable_version": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "byte_length": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "application/vnd.kryvola.tfhe-ciphertext"
      ]
    },
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    }
  },
  "required": [
    "opaque_artifact_id",
    "tenant_scope",
    "immutable_version",
    "manifest_digest",
    "byte_length",
    "media_type",
    "schema_version"
  ],
  "additionalProperties": false
}
