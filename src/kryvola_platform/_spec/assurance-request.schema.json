{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string",
      "enum": [
        "FHE-Q1"
      ]
    },
    "profile_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "requirements": {
      "type": "object",
      "properties": {
        "input_confidentiality": {
          "type": "string",
          "enum": [
            "OWNER_KEY_ENCRYPTION"
          ]
        },
        "computation_integrity": {
          "type": "string",
          "enum": [
            "UNPROVEN",
            "FHE_EVALUATION_PROVEN"
          ]
        },
        "input_validity": {
          "type": "string",
          "enum": [
            "NOT_ESTABLISHED",
            "COMPACT_ENCRYPTION_PROVEN"
          ]
        },
        "model_visibility": {
          "type": "string",
          "enum": [
            "PUBLIC",
            "PRIVATE"
          ]
        },
        "output_privacy": {
          "type": "string",
          "enum": [
            "ENCRYPTED_TO_OWNER"
          ]
        },
        "witness_privacy": {
          "type": "string",
          "enum": [
            "PUBLIC_DATA_ONLY",
            "ZERO_KNOWLEDGE"
          ]
        },
        "availability": {
          "type": "string",
          "enum": [
            "BEST_EFFORT",
            "GUARANTEED"
          ]
        }
      },
      "required": [
        "input_confidentiality",
        "computation_integrity",
        "input_validity",
        "model_visibility",
        "output_privacy",
        "witness_privacy",
        "availability"
      ],
      "additionalProperties": false
    },
    "evidence_policy": {
      "type": "string",
      "enum": [
        "NONE",
        "OPTIONAL_LATER",
        "REQUIRED_BEFORE_RELEASE"
      ]
    },
    "evidence_relations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "TFHE_COMPACT_INPUT",
          "PUBLIC_METADATA_COMMITMENT",
          "FHE_EVALUATION"
        ]
      },
      "maxItems": 3
    },
    "consent": {
      "type": "object",
      "properties": {
        "profile_id": {
          "type": "string",
          "enum": [
            "FHE-Q1"
          ]
        },
        "profile_version": {
          "type": "string",
          "enum": [
            "1"
          ]
        },
        "model_visibility": {
          "type": "string",
          "enum": [
            "PUBLIC"
          ]
        },
        "computation_integrity": {
          "type": "string",
          "enum": [
            "UNPROVEN"
          ]
        },
        "owner_endpoint_trust": {
          "type": "string",
          "enum": [
            "REQUIRED"
          ]
        },
        "residual_side_channels": {
          "type": "string",
          "enum": [
            "NOT_ELIMINATED"
          ]
        },
        "owner_compromise": {
          "type": "string",
          "enum": [
            "OUT_OF_SCOPE"
          ]
        },
        "accepted_leakage": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "INPUT_SHAPE",
              "MODEL_PROGRAM",
              "CRYPTO_PAYLOAD_SIZE",
              "TIMING",
              "ACCESS_PATTERN",
              "KEY_REUSE",
              "CACHE_STATE"
            ]
          },
          "maxItems": 7
        },
        "allow_unverified_release": {
          "type": "boolean"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "model_visibility",
        "computation_integrity",
        "owner_endpoint_trust",
        "residual_side_channels",
        "owner_compromise",
        "accepted_leakage",
        "allow_unverified_release"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "requirements",
    "evidence_policy",
    "evidence_relations",
    "consent"
  ],
  "additionalProperties": false
}
